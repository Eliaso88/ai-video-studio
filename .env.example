# Video Generation Configuration
# These can be set via environment variables or edited here

ANIMATEDIFF_URL=http://localhost:8001/generate
ANIMATEDIFF_TIMEOUT=300
TEMP_DIR=/tmp
FFMPEG_TIMEOUT=600
MAX_VIDEO_DURATION=300

# Logging
LOG_LEVEL=INFO

# Redis/RQ
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# AWS S3
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name

# Database
DATABASE_URL=postgresql://user:password@localhost/ai_video_db
